#!/bin/bash
# Tool created to quickly setup an environment for bug bounty.

# Added some colors found online. 
RED='\033[0;31m'
CYAN='\033[0;36m'
CLEAR='\033[0m'

# Logger function
logger() {
    echo -e "[$(date +%H:%M:%S)] $*"
}

# Declare associative arrays
declare -A installations=(
    ["subfinder"]="github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest"
    ["httpx"]="github.com/projectdiscovery/httpx/cmd/httpx@latest"
    ["nuclei"]="github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest"
    ["gospider"]="github.com/jaeles-project/gospider@latest"
    ["katana"]="github.com/projectdiscovery/katana/cmd/katana@latest"
    ["gf"]="github.com/tomnomnom/gf@latest"
    ["anew"]="github.com/tomnomnom/anew@latest"
    ["naabu"]="github.com/projectdiscovery/naabu/v2/cmd/naabu@latest"
    ["waybackurls"]="github.com/tomnomnom/waybackurls@latest"
    ["kxss"]="github.com/Emoe/kxss@latest"
    ["dalfox"]="github.com/hahwul/dalfox/v2@latest"
    ["gau"]="github.com/lc/gau/v2/cmd/gau@latest"
    ["gauplus"]="github.com/bp0lr/gauplus@latest"
    ["ffuf"]="github.com/ffuf/ffuf/v2@latest"
)

#
logger "${RED}[+]${CLEAR} Updating system & installing any required packages first"

# These are important to be able to run the script.
sudo apt install wget git curl build-essential libpcap-dev -y &> /dev/null

logger "${CYAN}✓${CLEAR} Packages installed"
sleep 1

logger "Checking and setting up Go..."
sleep 1

if command -v go &> /dev/null; then
    logger "${CYAN}✓${CLEAR} Go installed version: $(go version)"
    sleep 1
else
    logger "${RED}✗${CLEAR} Go not installed - installing now..."
    
    # Update packages
    sudo apt update -y &> /dev/null
    sudo apt upgrade -y &> /dev/null

    # Download Go
    logger "Downloading Go..."
    curl --output file.gz https://dl.google.com/go/go1.25.3.linux-amd64.tar.gz &> /dev/null
    sleep 2
    
    # Extract Go
    logger "Extracting Go..."
    sudo tar -C /usr/local -xzf file.gz
    
    # Clean up
    logger "Cleaning up..."
    sudo rm file.gz
    
    # Create Go workspace
    logger "${CYAN}[INFO]${CLEAR}Creating Go workspace..."
    mkdir -p ~/go/{bin,src,pkg}
    
    # Add to .bashrc if not already there
    if ! grep -q "GOROOT" ~/.bashrc; then
        logger "Adding Go to .bashrc..."
        echo "" >> ~/.bashrc
        echo "# Go Environment" >> ~/.bashrc
        echo "export GOROOT=/usr/local/go" >> ~/.bashrc
        echo "export GOPATH=\$HOME/go" >> ~/.bashrc
        echo "export PATH=\$PATH:\$GOROOT/bin:\$GOPATH/bin" >> ~/.bashrc
    fi
    
    sleep 2
    
    # Apply changes for current session
    export GOROOT=/usr/local/go
    export GOPATH=$HOME/go
    export PATH=$PATH:$GOROOT/bin:$GOPATH/bin
    
    sleep 2
    
    # Verify Go installation
    if command -v go &> /dev/null; then
        logger "${CYAN}✓${CLEAR} Go installed successfully: $(go version)"
    else
        logger "${RED}✗${CLEAR} Go installation failed"
        exit 1
    fi
    
    logger "${CYAN}✓${CLEAR} Installation complete! Restart your terminal or run: source ~/.bashrc"
fi


logger "${CYAN}[INFO]${CLEAR}Checking for bug bounty tools (${#installations[@]} total)..."

for tool in "${!installations[@]}"; do
    if command -v "$tool" &> /dev/null; then
        logger "${CYAN}✓${CLEAR} $tool is already installed"
        sleep 1
    else
        logger "${RED}✗${CLEAR} $tool is not installed - installing now..."
        go install "${installations[$tool]}" &> /dev/null
        sleep 1
        
        if command -v "$tool" &> /dev/null; then
            logger "${CYAN}✓${CLEAR} $tool installed successfully"
            sleep 1
        else
            logger "${RED}✗${CLEAR} $tool installation failed"
            sleep 1
        fi
    fi
done

sleep 2
logger "${CYAN}[INFO]${CLEAR} Checking if $USER has gf patterns installed!"


if ! grep -q "gf-completion.bash" ~/.bashrc || ! ls ~/.gf/*.json &> /dev/null; then
    logger "${RED}✗${CLEAR} $USER doesn't have gf-completion patterns installed! Installing now..."
    echo "source $GOPATH/pkg/mod/github.com/tomnomnom/gf@v0.0.0-20200618134122-dcd4c361f9f5/gf-completion.bash" >> ~/.bashrc
    sleep 1

    logger "${CYAN}[INFO]${CLEAR} Creating directories"
    mkdir -p ~/.gf
    sleep 1

    cp -r "$GOPATH"/pkg/mod/github.com/tomnomnom/gf@v0.0.0-20200618134122-dcd4c361f9f5/examples ~/.gf
    sleep 1

    logger "${CYAN}[INFO]${CLEAR} Downloading and installing gf patterns..."

    # Adding OR here just incase the git clone fails.
    git clone https://github.com/1ndianl33t/Gf-Patterns &> /dev/null || {
        logger "${RED}✗${CLEAR} Failed to clone patterns!"
        exit 1
    }
    mkdir -p ~/.gf
    sleep 1

    mv Gf-Patterns/*.json ~/.gf
    sleep 1

    rm -rf Gf-Patterns
    sleep 1

    logger "${CYAN}[INFO]${CLEAR} Checking if user has patterns"
    if ls ~/.gf/*.json 1> /dev/null 2>&1; then
        logger "${CYAN}✓${CLEAR} All packages and patterns installed! Script complete"
    else
        logger "${RED}✗${CLEAR} Error patterns not installed!"
        exit 1
    fi
else
    logger "${CYAN}✓${CLEAR} All packages and patterns installed! Script complete"
fi

logger "${RED}[WARN]${CLEAR} Please type: source ~/.bashrc to complete setup and load PATHs"
logger "${CYAN}✓${CLEAR} Setup complete enjoy ;)"